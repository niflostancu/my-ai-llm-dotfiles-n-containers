# Base container for AI agents / tools (usually both)
FROM debian:13

# Install shared base layer
COPY --chmod=755 scripts/install-base.sh /tmp/install-base.sh
RUN INSTALL_GO=1 /tmp/install-base.sh full \
    && rm /tmp/install-base.sh

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    HOME=/home/agent \
    PATH="/usr/local/go/bin:${PATH}"

COPY --chmod=755 scripts/ /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/entrypoint-base.sh"]
WORKDIR /tmp

# note: entrypoint will run the command as `agent`
CMD ["/bin/bash"]

